{
  "layer": "L3",
  "layer_name": "Mainboard",
  "protocol_version": "9.2.0",
  "slot_types": ["tool", "prompt", "track", "observer", "event"],
  "plugins": {
    "prompt": {
      "core_prompts": {
        "module": "mainboard.slots.prompts.core_prompts.main",
        "class": "CorePromptBundle",
        "description": "V9 核心提示词 Bundle — Planning, Synthesis, Critic, Tool Resolver"
      }
    },
    "track": {
      "C": {
        "module": "mainboard.track.track_c",
        "class": "RealTrackC",
        "description": "Tool Execution → Critic pipeline (no planning)"
      }
    },
    "observer": {
      "semantic_trust": {
        "module": "observer.observer",
        "class": "SemanticTrustObserver",
        "description": "ML-based semantic trust observer"
      }
    },
    "event": {},
    "tool": {}
  }
}
